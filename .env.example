APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO

POSTGRES_DB=stock_tracker
POSTGRES_USER=stock
POSTGRES_PASSWORD=stock
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://stock:stock@db:5432/stock_tracker

# Quelldatenbank im lokalen Netzwerk, nur lesender Zugriff (docs/plan.md Abschnitt 8).
# Noch nicht konfiguriert -- findash sync check/run/full lehnen ohne diesen Wert ab.
SOURCE_DATABASE_URL=

DISPLAY_TIMEZONE=Europe/Berlin
STALE_FORECAST_HOURS=36

WEB_PORT=5000
